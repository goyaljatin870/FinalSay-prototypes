{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/icons/*",
      "/manifest.webmanifest",
      "/sw.js",
      "/workbox-*.js",
      "/*.{png,jpg,jpeg,gif,svg,ico,css,js,woff,woff2}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
